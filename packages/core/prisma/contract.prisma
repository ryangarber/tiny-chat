// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
types {
  Embedding = pgvector.Vector()
  zSettings = zod.Json("zSettings")
  zCache = zod.Json("zCache")
  zConfig = zod.Json("zConfig")
  zData = zod.Json("zData")
  zMetadata = zod.Json("zMetadata")
}

namespace public {
  model User {
    id            String       @id(map: "user_pkey")
    name          String
    email         String
    emailVerified Boolean      @default(false)
    image         String?
    createdAt     Timestamp(3) @default(now())
    updatedAt     Timestamp(3)
    isAnonymous   Boolean?     @default(false)
    settings      zSettings    @default(sql`'{}'::jsonb`)
    cache         zCache       @default(sql`'{}'::jsonb`)
    isEphemeral   Boolean?     @default(false)
    accounts      Account[]
    actions       Action[]
    chats         Chat[]
    dreams        Dream[]
    files         File[]
    projects      Project[]
    memories      Memory[]
    messages      Message[]
    sessions      Session[]
    subagents     Subagent[]
    uploads       Upload[]

    @@index([email], map: "user_email_key", unique: true)
    @@map("user")
  }

  model Account {
    id                    String        @id(map: "account_pkey")
    accountId             String
    providerId            String
    userId                String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  Timestamp(3)?
    refreshTokenExpiresAt Timestamp(3)?
    scope                 String?
    password              String?
    createdAt             Timestamp(3)  @default(now())
    updatedAt             Timestamp(3)
    user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "account_userId_fkey")

    @@index([userId], map: "account_userId_idx")
    @@map("account")
  }

  model Project {
    id        String       @id(map: "project_pkey")
    userId    String
    title     String?
    createdAt Timestamp(3) @default(now())
    chats     Chat[]
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "project_userId_fkey")
    settings  zSettings    @default(sql`'{}'::jsonb`)

    @@index([userId], map: "project_userId_idx")
    @@map("project")
  }

  model Chat {
    id        String       @id(map: "chat_pkey")
    userId    String
    projectId String?
    title     String?
    createdAt Timestamp(3) @default(now())
    temporary Boolean      @default(false)
    incognito Boolean      @default(false)
    files     File[]
    messages  Message[]
    project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "chat_projectId_fkey")
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "chat_userId_fkey")

    @@index([projectId], map: "chat_projectId_idx")
    @@index([userId], map: "chat_userId_idx")
    @@map("chat")
  }

  model MessageContext {
    messageId String
    memoryId  String
    message   Message @relation(name: "MessageContext", fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "message_context_messageId_fkey")
    memory    Memory  @relation(name: "MessageContext", fields: [memoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "message_context_memoryId_fkey")

    @@id([messageId, memoryId], map: "message_context_pkey")
    @@index([messageId], map: "message_context_messageId_idx")
    @@index([memoryId], map: "message_context_memoryId_idx")
    @@map("message_context")
  }

  model Message {
    id         String          @id(map: "message_pkey")
    userId     String
    chatId     String
    previousId String?
    author     pg.enum(Author)
    config     zConfig
    data       zData
    metadata   zMetadata
    embedding  Embedding?
    createdAt  Timestamp(3)    @default(now())
    updatedAt  Timestamp(3)?
    actions    Action[]
    dreams     Dream[]
    memories   Memory[]
    subagents  Subagent[]
    chat       Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "message_chatId_fkey")
    previous   Message?        @relation(name: "message_previousId_fkey", fields: [previousId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "message_previousId_fkey")
    next       Message[]       @relation(name: "message_previousId_fkey")
    user       User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "message_userId_fkey")
    context    Memory[]        @relation("MessageContext")

    @@index([chatId], map: "message_chatId_idx")
    @@index([previousId], map: "message_previousId_key")
    @@index([userId], map: "message_userId_idx")
    @@map("message")
  }

  model Action {
    id        String        @id(map: "action_pkey")
    userId    String
    schedule  String
    config    zConfig
    data      zData
    embedding Embedding?
    createdAt Timestamp(3)  @default(now())
    messageId String
    lastRanAt Timestamp(3)?
    timezone  String
    message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "action_messageId_fkey")
    user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "action_userId_fkey")

    @@index([messageId], map: "action_messageId_idx")
    @@index([userId], map: "action_userId_idx")
    @@map("action")
  }

  model Dream {
    id        String       @id(map: "dream_pkey")
    userId    String
    data      zData
    metadata  zMetadata
    createdAt Timestamp(3) @default(now())
    config    zConfig
    messages  Message[]
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "dream_userId_fkey")

    @@index([userId], map: "dream_userId_idx")
    @@map("dream")
  }

  model DreamMessage {
    dreamId   String
    messageId String
    dream     Dream   @relation(fields: [dreamId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "dream_message_dreamId_fkey")
    message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "dream_message_messageId_fkey")

    @@id([messageId, dreamId], map: "dream_message_pkey")
    @@index([dreamId], map: "dream_message_dreamId_idx")
    @@index([messageId], map: "dream_message_messageId_idx")
    @@map("dream_message")
  }

  model Upload {
    id        String              @id(map: "upload_pkey")
    userId    String
    name      String
    createdAt Timestamp(3)        @default(now())
    kind      pg.enum(UploadKind)
    thumbnail Bytes?
    files     File[]
    user      User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "upload_userId_fkey")

    @@index([userId], map: "upload_userId_idx")
    @@map("upload")
  }

  model File {
    id        String        @id(map: "file_pkey")
    userId    String
    uploadId  String?
    path      String[]
    mime      String
    data      Bytes
    embedding Embedding?
    createdAt Timestamp(3)  @default(now())
    updatedAt Timestamp(3)?
    chatId    String?
    chat      Chat?         @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "file_chatId_fkey")
    upload    Upload?       @relation(fields: [uploadId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "file_uploadId_fkey")
    user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "file_userId_fkey")

    @@index([chatId], map: "file_chatId_idx")
    @@index([uploadId], map: "file_uploadId_idx")
    @@index([userId], map: "file_userId_idx")
    @@map("file")
  }

  model Memory {
    id         String                   @id(map: "memory_pkey")
    userId     String
    config     zConfig?
    fact       String
    category   pg.enum(MemoryCategory)
    stability  pg.enum(MemoryStability)
    evidence   String[]
    confidence Float
    embedding  Embedding?
    createdAt  Timestamp(3)             @default(now())
    updatedAt  Timestamp(3)?
    messageId  String?
    message    Message?                 @relation(fields: [messageId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "memory_messageId_fkey")
    user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "memory_userId_fkey")
    contexts   Message[]                @relation("MessageContext")

    @@index([messageId], map: "memory_messageId_idx")
    @@index([userId], map: "memory_userId_idx")
    @@map("memory")
  }

  model Session {
    id        String       @id(map: "session_pkey")
    expiresAt Timestamp(3)
    token     String
    createdAt Timestamp(3) @default(now())
    updatedAt Timestamp(3)
    ipAddress String?
    userAgent String?
    userId    String
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "session_userId_fkey")

    @@index([token], map: "session_token_key", unique: true)
    @@index([userId], map: "session_userId_idx")
    @@map("session")
  }

  model Subagent {
    id        String       @id(map: "subagent_pkey")
    createdAt Timestamp(3) @default(now())
    data      zData
    messages  Message[]
    metadata  zMetadata
    userId    String
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "subagent_userId_fkey")
    partId    String

    @@index([partId], map: "subagent_partId_key", unique: true)
    @@index([userId], map: "subagent_userId_idx")
    @@map("subagent")
  }

  model MessageSubagent {
    messageId  String
    subagentId String
    message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "message_subagent_messageId_fkey")
    subagent   Subagent @relation(fields: [subagentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "message_subagent_subagentId_fkey")

    @@id([messageId, subagentId], map: "message_subagent_pkey")
    @@index([messageId], map: "message_subagent_messageId_idx")
    @@index([subagentId], map: "message_subagent_subagentId_idx")
    @@map("message_subagent")
  }

  model Verification {
    id         String       @id(map: "verification_pkey")
    identifier String
    value      String
    expiresAt  Timestamp(3)
    createdAt  Timestamp(3) @default(now())
    updatedAt  Timestamp(3)

    @@index([identifier], map: "verification_identifier_idx")
    @@map("verification")
  }

  native_enum Author {
    USER = "USER"
    _mODEL = "MODEL"
  }

  native_enum MemoryCategory {
    IDENTITY = "IDENTITY"
    PREFERENCES = "PREFERENCES"
    PROJECTS = "PROJECTS"
    SKILLS = "SKILLS"
    CONSTRAINTS = "CONSTRAINTS"
  }

  native_enum MemoryStability {
    SHORT_TERM = "SHORT_TERM"
    MEDIUM_TERM = "MEDIUM_TERM"
    LONG_TERM = "LONG_TERM"
  }

  native_enum UploadKind {
    ATTACHMENT = "ATTACHMENT"
    SKILL = "SKILL"
    GITHUB = "GITHUB"
  }
}
