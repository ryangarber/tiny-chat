{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": ["**", "!public", "!src/theme.css", "!generated"]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"rules": {
			"nursery": {
				"useReactCompiler": "error"
			}
		},
		"domains": {
			"react": "recommended"
		}
	}
}
