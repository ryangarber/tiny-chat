{
	"name": "server",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --watch --watch-preserve-output src/server.ts",
		"start": "node src/server.ts",
		"lint": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"smoketest": "node scripts/smoketest.ts",
		"prisma": "prisma"
	},
	"imports": {
		"#core/*": "core/*",
		"#server/*": "./src/*"
	},
	"exports": {
		"./*": "./src/*"
	},
	"dependencies": {
		"@prisma/orm-extension-paradedb": "catalog:prisma",
		"@prisma/orm-extension-pgvector": "catalog:prisma",
		"@prisma/orm-postgres": "catalog:prisma",
		"@ryangarber/ai-sdk-antigravity-proxy": "^0.1.4",
		"@ryangarber/prisma-orm-extension-zod": "catalog:prisma",
		"chalk": "^6.0.1",
		"core": "workspace:*",
		"fflate": "^0.8.3",
		"just-bash": "^3.6.0"
	},
	"devDependencies": {
		"typescript": "catalog:typescript"
	}
}
