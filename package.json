{
	"name": "tiny-chat",
	"type": "module",
	"private": true,
	"version": "0.10.24",
	"productName": "Tiny Chat",
	"productIdentifier": "dev.ryangarber.chat",
	"productScheme": "tinychat",
	"description": "LLMs without the bloat.",
	"scripts": {
		"dev:server": "pnpm --filter server run dev",
		"start:server": "pnpm --filter server run start",
		"start:web": "pnpm --filter app run start:web",
		"dev:desktop": "pnpm --filter app run dev:electron",
		"dev:desktop:dist": "pnpm --filter app run dev:electron:dist",
		"dev:ios": "pnpm --filter app run dev:ios",
		"dev:ios:dist": "pnpm --filter app run dev:ios:dist",
		"dev:android": "pnpm --filter app run dev:android",
		"dev:android:dist": "pnpm --filter app run dev:android:dist",
		"dev:web": "node scripts/use-server.ts \"[web] pnpm --filter app run dev:web\"",
		"dev:cli": "pnpm --filter cli run dev",
		"build:web": "pnpm --filter app run build:web",
		"build:desktop": "pnpm --filter app run build:electron",
		"build:ios": "pnpm --filter app run build:ios",
		"build:android": "pnpm --filter app run build:android",
		"build:cli": "pnpm --filter cli run build",
		"build:assets": "node scripts/build-assets.ts",
		"typecheck": "turbo typecheck --continue",
		"lint": "turbo lint --continue",
		"test": "turbo test --continue",
		"test:coverage": "vitest run --coverage",
		"smoketest": "turbo smoketest --continue",
		"knip": "knip",
		"actionlint": "actionlint -ignore 'label \"xcode-27\"'",
		"prisma": "pnpm --filter server prisma",
		"cap": "pnpm --filter app cap"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@ryangarber/utils": "^0.1.6",
		"@types/node": "^26.6.7",
		"@vitest/coverage-v8": "^5.1.1",
		"bun-types": "^1.4.5",
		"chalk": "^6.0.1",
		"concurrently": "^10.0.7",
		"knip": "^6.48.0",
		"playwright": "^1.65.1",
		"prisma": "catalog:prisma",
		"tsx": "^4.23.15",
		"turbo": "^2.11.13",
		"typescript": "catalog:typescript",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"wait-on": "^9.5.1"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "^2.4.0",
		"@optique/core": "^1.4.0",
		"@optique/man": "^1.4.0",
		"@optique/run": "^1.4.0",
		"@prisma/orm-postgres": "catalog:prisma",
		"@trpc/client": "^11.31.3",
		"@trpc/server": "^11.31.3",
		"ai": "catalog:ai",
		"better-auth": "^1.7.28",
		"better-auth-prisma-orm": "catalog:prisma",
		"dotenv": "^18.0.10",
		"internal-ip": "^9.0.0",
		"sharp": "^0.35.5",
		"sharp-ico": "^0.1.5",
		"superjson": "^2.2.7",
		"temporal-polyfill": "^1.0.8",
		"temporal-zod": "^0.8.0",
		"zod": "^4.6.7"
	},
	"bugs": {
		"url": "https://github.com/ryangarber/tiny-chat/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/tiny-chat.git"
	},
	"packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
	"devEngines": {
		"runtime": [
			{
				"name": "node",
				"version": ">=24 <27",
				"onFail": "download"
			},
			{
				"name": "bun",
				"version": ">=1.4 <2",
				"onFail": "download"
			}
		]
	}
}
