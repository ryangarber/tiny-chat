{
	"name": "tiny-chat",
	"type": "module",
	"private": true,
	"version": "0.10.1",
	"scripts": {
		"dev:server": "pnpm --filter server run dev",
		"start:server": "pnpm --filter server run start",
		"start:web": "pnpm --filter web run start",
		"dev:gui": "pnpm --filter gui run dev",
		"dev:desktop": "pnpm --filter desktop run dev",
		"dev:desktop:dist": "pnpm --filter desktop run dev:dist",
		"dev:ios": "pnpm --filter mobile run dev:ios",
		"dev:ios:dist": "pnpm --filter mobile run dev:ios:dist",
		"dev:android": "pnpm --filter mobile run dev:android",
		"dev:android:dist": "pnpm --filter mobile run dev:android:dist",
		"dev:web": "node scripts/use-server.ts \"[web] pnpm --filter web run dev\"",
		"dev:cli": "pnpm --filter cli run dev",
		"build:gui": "pnpm --filter gui run build",
		"build:desktop": "pnpm --filter desktop run build",
		"build:ios": "pnpm --filter mobile run build:ios",
		"build:android": "pnpm --filter mobile run build:android",
		"build:cli": "pnpm --filter cli run build",
		"build:assets": "node scripts/build-assets.ts",
		"typecheck": "turbo typecheck --continue",
		"lint": "turbo lint --continue",
		"test": "turbo test --continue",
		"smoketest": "turbo smoketest --continue",
		"knip": "knip",
		"actionlint": "actionlint -ignore 'label \"xcode-27\"'",
		"prisma": "pnpm --filter server prisma"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.5",
		"bun-types": "^1.4.3",
		"chalk": "^6.0.1",
		"concurrently": "^10.0.6",
		"knip": "^6.41.0",
		"playwright": "^1.64.1",
		"prisma": "catalog:prisma",
		"tsx": "^4.23.15",
		"turbo": "^2.11.9",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wait-on": "^9.5.1"
	},
	"dependencies": {
		"@commander-js/extra-typings": "^15.0.0",
		"@modelcontextprotocol/client": "^2.3.1",
		"@prisma/orm-postgres": "catalog:prisma",
		"@ryangarber/better-auth-adapter-prisma": "catalog:prisma",
		"@trpc/client": "^11.19.0",
		"@trpc/server": "^11.19.0",
		"ai": "^7.0.143",
		"better-auth": "^1.7.10",
		"dotenv": "^18.0.8",
		"internal-ip": "^9.0.0",
		"sharp": "^0.35.5",
		"sharp-ico": "^0.1.5",
		"superjson": "^2.2.6",
		"temporal-polyfill": "^1.0.6",
		"temporal-zod": "^0.8.0",
		"zod": "^4.6.7"
	},
	"bugs": {
		"url": "https://github.com/ryangarber/tiny-chat/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/tiny-chat.git"
	},
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "download"
		}
	}
}
