+/**
+ * Whether a dependency's native code is tied to Node's ABI: it compiles from
+ * a `binding.gyp`, or it ships a prebuilt `.node` addon that isn't N-API
+ * (`*.napi.node`, ABI-stable across Node and Electron). A `prebuilds`
+ * directory of plain shared libraries, opened through FFI, isn't either.
+ */
+function needsElectronRebuild(dependencyDir) {
+    const prebuilds = path.join(dependencyDir, 'prebuilds');
+    const addons = fs.existsSync(prebuilds)
+        ? fs.readdirSync(prebuilds, { recursive: true })
+            .map(String)
+            .filter(file => file.endsWith('.node'))
+        : [];
+    if (addons.length > 0) {
+        return addons.some(file => !/napi[^\\/]*\.node$/.test(file));
+    }
+    return fs.existsSync(path.join(dependencyDir, 'binding.gyp'));
