{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"lint": {
			"dependsOn": ["^lint"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"smoketest": {
			"dependsOn": ["^smoketest"]
		}
	},
	"globalPassThroughEnv": ["DEV", "DEV_HOST", "DEV_REMOTE", "DEV_ENV"]
}
