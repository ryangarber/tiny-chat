{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "web",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"dev:web"
			],
			"port": 8010
		},
		{
			"name": "mobile (gui + server)",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"exec",
				"node",
				"scripts/use-server.ts",
				"[gui] pnpm --filter mobile exec vite"
			],
			"port": 8010
		},
		{
			"name": "server",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"dev:server"
			],
			"port": 8009
		},
		{
			"name": "cli (testing, no keyring)",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"dev:cli",
				"--no-keyring"
			]
		}
	]
}
