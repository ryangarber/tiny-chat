{
	"compilerOptions": {
		"lib": ["ES2024"],
		"types": [
			"vitest/globals",
			"vitest/importMeta",
			"temporal-polyfill/types/global"
		],
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"esModuleInterop": true
	}
}
