{
	"name": "cli",
	"private": true,
	"type": "module",
	"imports": {
		"#core/*": "core/*",
		"#client/*": "client/*",
		"#tui/*": "tui/*",
		"#cli/*": "./src/*"
	},
	"exports": {
		"./*": "./src/*"
	},
	"scripts": {
		"dev": "bun ./scripts/dev.ts",
		"build": "bun ./scripts/build.ts",
		"lint": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"smoketest": "bun ./scripts/smoketest.ts"
	},
	"dependencies": {
		"@babel/core": "^8.0.7",
		"@napi-rs/keyring": "^2.1.1",
		"@tanstack/react-query": "^5.104.3",
		"client": "workspace:*",
		"core": "workspace:*",
		"ink": "^8.0.0",
		"react": "^19.3.1",
		"tui": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"babel-plugin-react-compiler": "^1.0.0"
	},
	"devEngines": {
		"runtime": [
			{
				"name": "node",
				"version": "^24.0.0",
				"onFail": "download"
			},
			{
				"name": "bun",
				"version": "^1.4.0",
				"onFail": "download"
			}
		]
	}
}
