{
	"name": "cli",
	"private": true,
	"type": "module",
	"imports": {
		"#core/*": "core/*",
		"#client/*": "client/*",
		"#tui/*": "tui/*",
		"#cli/*": "./src/*"
	},
	"exports": {
		"./*": "./src/*"
	},
	"scripts": {
		"dev": "bun ./scripts/dev.ts",
		"build": "bun ./scripts/build.ts",
		"lint": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"smoketest": "bun ./scripts/smoketest.ts"
	},
	"dependencies": {
		"@afmize/node": "catalog:ai",
		"@babel/core": "^8.1.0",
		"@napi-rs/keyring": "^2.1.2",
		"@tanstack/react-query": "^5.107.1",
		"better-ink-picture": "^0.1.0",
		"client": "workspace:*",
		"core": "workspace:*",
		"ink": "^8.0.0",
		"react": "catalog:react",
		"tui": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "catalog:react",
		"babel-plugin-react-compiler": "catalog:react"
	}
}
